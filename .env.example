# ─── Microsoft 365 (covers Outlook email + OneNote — one login) ───────────────
# Register a free Azure app at https://portal.azure.com → Azure Active Directory
# → App registrations → New registration → add these redirect URIs:
#   http://localhost  (for desktop/device code flow)
# Then under API Permissions add:
#   Mail.Read, Notes.Read.All, offline_access
MS_CLIENT_ID=your-azure-app-client-id-here
MS_TENANT_ID=common

# ─── Salesforce (optional — try it, fallback to email if no access) ───────────
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login

# ─── App settings ─────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string
DB_PATH=account_hub.db
PORT=5000

# Email sender filter (only parse reports from these addresses)
REPORT_SENDERS=tableau-no-reply@haemonetics.com,noreply@haemonetics.com
