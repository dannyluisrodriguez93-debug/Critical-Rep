# ─── Account Hub — Environment Variables ─────────────────────────────────────
#
# You don't need to edit this file manually.
# All integration settings (Google, Salesforce, etc.) can be configured
# through the Integrations page inside the app.
#
# This file is for advanced users who want to pre-configure settings.
# Copy this file to ".env" if you want to use it.
#
# ─────────────────────────────────────────────────────────────────────────────

# App settings (optional — defaults work fine)
SECRET_KEY=change-this-to-a-long-random-string
PORT=5000

# Google OAuth (set through the Integrations page instead of here)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# Salesforce (set through the Integrations page instead of here)
# SF_USERNAME=you@company.com
# SF_PASSWORD=your-password
# SF_SECURITY_TOKEN=your-security-token
# SF_DOMAIN=login

# Email report sender filter (set through the Integrations page instead of here)
# REPORT_SENDERS=tableau-no-reply@haemonetics.com,noreply@haemonetics.com
